{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "src/public/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": false
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": [
        "src/public/js/app.js"
      ],
      "globals": {
        "api": "readonly"
      }
    }
  ]
}
