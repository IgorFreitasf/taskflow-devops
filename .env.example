# Configurações da Aplicação
PORT=3000
NODE_ENV=development

# Segredo do JWT (Utilize uma chave forte e aleatória em produção)
JWT_SECRET=super_segredo_jwt_taskflow_devops_2024

# Banco de Dados PostgreSQL (Local ou Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# Ou URL direta de conexão (como a fornecida pelo Render / Supabase / Railway)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/taskflow_db

# Nível de Log (debug, info, warn, error)
LOG_LEVEL=info
